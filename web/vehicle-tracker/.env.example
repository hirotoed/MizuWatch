# Google Maps JavaScript API key
# Restrict this key to your development/production web origins and to the
# Maps JavaScript API in Google Cloud Console.
VITE_GMAPS_API_KEY=your_google_maps_api_key_here

# Keep mock for offline UI development. Use supabase for the formal API path.
VITE_VEHICLE_DATA_SOURCE=mock
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
