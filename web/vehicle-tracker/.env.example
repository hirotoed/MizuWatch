# Google Maps JavaScript API key
# Restrict this key to your development/production web origins and to the
# Maps JavaScript API in Google Cloud Console.
VITE_GMAPS_API_KEY=your_google_maps_api_key_here

# Deployed Google Apps Script Web App URL (ending in /exec)
VITE_GAS_ENDPOINT=https://script.google.com/macros/s/your_deployment_id/exec

# Optional compatibility list for legacy one-vehicle GAS deployments.
# Format: VEHICLE_ID|URL,VEHICLE_ID|URL
VITE_LEGACY_GAS_ENDPOINTS=DRONE_001|https://script.google.com/macros/s/drone_1_deployment_id/exec,DRONE_002|https://script.google.com/macros/s/drone_2_deployment_id/exec
